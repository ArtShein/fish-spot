<%= form_with model: trip, url: wizard_trip_name_trips_path, method: :post do |f| %>
  <% if trip.errors.any? %>
    <div class="text-red-700 mb-4">
      <h2><%= t("global.messages.errors", count: trip.errors.count) %></h2>
      <ul>
        <% trip.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :location_id %>

  <div class="mb-6">
    <%= f.label :name, t("trips.form.trip_title"), style: "display: block", class: "font-medium" %>
    <p class="text-sm text-gray-600 mb-2"><%= t("trips.wizard.trip_name_hint") %></p>
    <%= f.text_field :name,
          class: "w-full max-w-md border rounded px-2 py-2 text-lg",
          autocomplete: "off",
          required: true,
          aria: { required: true } %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_tag t("trips.wizard.next"), type: "submit", name: nil, class: "bg-blue-600 text-white font-semibold py-2 px-5 rounded" %>
    <%= link_to t("trips.wizard.back_to_location"), new_trip_path, class: "text-gray-600 hover:underline text-sm" %>
  </div>
<% end %>
