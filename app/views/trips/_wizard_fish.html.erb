<%= form_with model: trip, url: trip_path(trip), method: :patch do |f| %>
  <%= hidden_field_tag "trip[wizard_fish]", "1" %>

  <% if trip.errors.any? %>
    <div class="text-red-700 mb-4">
      <h2><%= t("global.messages.errors", count: trip.errors.count) %></h2>
      <ul>
        <% trip.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="border border-gray-200 rounded p-4 mb-4">
    <legend class="font-semibold px-1"><%= t("trips.wizard.fish_section") %></legend>
    <p class="text-sm text-gray-600 mb-3"><%= t("trips.wizard.fish_hint") %></p>

    <div data-controller="nested-fish-rows">
      <div data-nested-fish-rows-target="container">
        <%= f.fields_for :fishes do |ff| %>
          <%= render "wizard_fish_row", ff: ff %>
        <% end %>
      </div>

      <div class="mt-2">
        <button
          type="button"
          data-action="nested-fish-rows#add"
          class="text-sm font-medium text-blue-700 hover:text-blue-900 hover:underline"
        >
          <%= t("trips.wizard.add_fish_row") %>
        </button>
      </div>

      <template data-nested-fish-rows-target="template">
        <%= f.fields_for :fishes, Fish.new, child_index: "NEW_RECORD" do |ff| %>
          <%= render "wizard_fish_row", ff: ff %>
        <% end %>
      </template>
    </div>
  </fieldset>

  <div class="flex flex-wrap gap-3 items-center">
    <%= button_tag t("trips.wizard.save_trip"), type: "submit", name: nil, class: "bg-green-600 text-white font-semibold py-2 px-5 rounded" %>
    <%= link_to t("trips.wizard.back_to_trip_name"), edit_trip_path(trip), class: "text-gray-600 hover:underline text-sm" %>
    <%= link_to t("trips.wizard.skip_fish"), trip_path(trip), class: "text-sm text-blue-600 hover:underline" %>
  </div>
<% end %>
