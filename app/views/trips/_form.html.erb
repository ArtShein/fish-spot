<%= form_with(model: trip) do |f| %>
  <% if trip.errors.any? %>
    <div style="color: red">
      <h2><%= t('global.messages.errors', count: trip.errors.count) %></h2>

      <ul>
        <% trip.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label t('trips.form.name'), style: "display: block" %>
    <%= f.text_field :name %>
  </div>

  <% location_markers = @locations.map { |l| { id: l.id, name: l.name, lat: l.latitude&.to_f, lng: l.longitude&.to_f } } %>
  <% geocode_url = geocode_reverse_path(format: :json) %>

  <%= tag.div(
        class: "not-prose w-full mt-4",
        data: {
          controller: "trip-map",
          trip_map_mode_value: "picker",
          trip_map_geocode_url_value: geocode_url,
          trip_map_locations_value: location_markers
        }
      ) do %>
    <div class="mb-3">
      <%= f.label :location_id, t("trips.form.pick_location"), style: "display: block" %>
      <%= f.collection_select :location_id, @locations, :id, :name,
            { include_blank: t("trips.form.new_location") },
            data: {
              trip_map_target: "locationSelect",
              action: "change->trip-map#syncFromLocationSelect"
            } %>
    </div>

    <%= f.fields_for :location do |lf| %>
      <%= lf.hidden_field :id, data: { trip_map_target: "idField" } %>

      <div class="mb-2">
        <%= lf.label :name, style: "display: block" %>
        <%= lf.text_field :name,
              data: {
                trip_map_target: "nameField",
                action: "input->trip-map#onNameInput"
              } %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-2">
        <div>
          <%= lf.label :accessibility, style: "display: block" %>
          <%= lf.select :accessibility, Location.accessibilities.keys.map { |key| [t("enums.location.accessibility.#{key}"), key] } %>
        </div>
        <div>
          <%= lf.label :conditions, style: "display: block" %>
          <%= lf.select :conditions, Location.conditions.keys.map { |key| [t("enums.location.conditions.#{key}"), key] } %>
        </div>
        <div>
          <%= lf.label :proximity, style: "display: block" %>
          <%= lf.select :proximity, Location.proximities.keys.map { |key| [t("enums.location.proximity.#{key}"), key] } %>
        </div>
      </div>

      <%= render "shared/leaflet_map",
            variant: :picker,
            form: lf,
            height: "min(55vh, 420px)",
            picker_wrapper: false,
            hint_key: "trips.form.map_click_hint" %>
    <% end %>
  <% end %>

  <div class="mt-4">
    <%= f.submit %>
  </div>
<% end %>
