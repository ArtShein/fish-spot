<% content_for :title, t("trips.wizard.page_title") %>

<h1 class="text-2xl font-bold mb-2"><%= t("trips.wizard.title") %></h1>

<% case @wizard_step
   when :fish %>
  <p class="text-sm text-gray-600 mb-4"><%= t("trips.wizard.step3_intro", trip: @trip.name, location: @location.display_name) %></p>
  <%= render "wizard_fish", trip: @trip %>
<% when :trip_name %>
  <p class="text-sm text-gray-600 mb-4"><%= t("trips.wizard.step2_intro", location: @location.display_name) %></p>
  <%= render "wizard_trip_name", trip: @trip %>
<% else %>
  <p class="text-sm text-gray-600 mb-4"><%= t("trips.wizard.step1_intro") %></p>
  <%= render "wizard_location", location: @location %>
<% end %>
