<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "FishSpot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css", crossorigin: "anonymous" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% unless devise_controller? %>
      <%= render 'dashboard/navigation' %>
    <% end %>
    <main class="mx-auto max-w-5xl py-6">
      <% main_content = capture { yield } %>
      <% unless devise_controller? %>
        <% on_dashboard = controller_name == "dashboard" && action_name == "index" %>
        <% unless content_for?(:hide_page_back) || on_dashboard %>
          <% back_href = yield(:page_back_url).presence || page_back_href %>
          <% back_label = yield(:page_back_label).presence || t("global.back") %>
          <div class="not-prose mb-3 mx-20">
            <%= render "shared/page_back", back_href: back_href, back_label: back_label %>
          </div>
        <% end %>
      <% end %>
      <div class="min-w-0 px-4">
        <%= main_content %>
      </div>
    </main>
  </body>
</html>
