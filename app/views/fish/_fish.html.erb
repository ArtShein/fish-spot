<div id="<%= dom_id fish %>">
  <p>
    <strong>Name:</strong>
    <%= fish.name %>
  </p>

  <p>
    <strong>Quantity:</strong>
    <%= fish.quantity %>
  </p>

  <p>
    <strong><%= t("activerecord.attributes.fish.kind") %>:</strong>
    <%= fish.kind.present? ? t("enums.fish.kind.#{fish.kind}") : "—" %>
  </p>

  <p>
    <strong>Weight:</strong>
    <%= fish.weight %>
  </p>

</div>
